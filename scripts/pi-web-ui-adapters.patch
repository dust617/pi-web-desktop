+
+test("still commits immediately when text follows thinking", async () => {
+  let retries = 0;
+  const textDelta = {
+    type: "text_delta",
+    contentIndex: 1,
+    delta: "answer",
+    partial: { ...thinkingPartial("hmm"), content: [...thinkingPartial("hmm").content, { type: "text", text: "answer" }] },
+  };
+  const output = withEmptyAbortRetries(
