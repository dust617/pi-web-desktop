+}
+const thinkingStart = { type: "thinking_start", contentIndex: 0, partial: thinkingPartial("") };
+const thinkingDelta = (text) => ({ type: "thinking_delta", contentIndex: 0, delta: text, partial: thinkingPartial(text) });
