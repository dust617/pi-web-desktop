{
  "name": "model-router-auto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Intelligent model router & orchestrator for Pi coding agent — routes tasks to optimal LLM at inference boundaries.",
  "license": "MIT",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test \"dist/test/**/*.test.js\"",
    "data:check": "node scripts/holdout-stats.mjs --check",
    "router:patch": "node scripts/apply-pi-model-auto-supervisor-patch.mjs",
    "router:patch:check": "node scripts/apply-pi-model-auto-supervisor-patch.mjs --check",
    "gate": "npm ci --include=dev && npm run check && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "file:../../resources/pi-web/node_modules/@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent": "file:../../resources/pi-web/node_modules/@earendil-works/pi-coding-agent",
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.8.0",
    "@earendil-works/pi-coding-agent": ">=0.8.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": false },
    "@earendil-works/pi-coding-agent": { "optional": false }
  }
}
